DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@127.0.0.1:5432/barbearia
# Schema do backend atual: salaoflix (padrao). Nao e necessario configurar no Render.
# DATABASE_SCHEMA=salaoflix
# PostgreSQL exclusivo de testes; nunca use o banco de clientes.
# TEST_DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@127.0.0.1:5432/barbearia_test
JWT_SECRET=CHANGE_THIS_JWT_SECRET
JWT_EXPIRES_IN=12h
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_MODE=production
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# URL publica do backend para receber atualizacoes da Evolution.
PUBLIC_APP_URL=https://barbearia-net.onrender.com
# Timeout por requisicao; conexao completa limitada a 60s. Diagnostique antes de ajustar.
EVOLUTION_API_TIMEOUT_MS=20000
EVOLUTION_API_RETRY_ATTEMPTS=1
EVOLUTION_API_RETRY_DELAY_MS=2000
PORT=3000
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3000
DEFAULT_PLAN_AMOUNT_CENTS=6500
DEFAULT_PLAN_NAME=Plano Mensal SaaS
GRACE_DAYS=4
